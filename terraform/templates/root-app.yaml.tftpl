# GENERATED by Terraform (terraform/gitops.tf). Applied once by scripts/bootstrap-gitops.sh.
# App-of-apps: everything under gitops/apps/ becomes an Argo CD Application.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: nrg-root
  namespace: argocd
  finalizers: [resources-finalizer.argocd.argoproj.io]
spec:
  project: default
  source:
    repoURL: ${repo_url}
    targetRevision: ${revision}
    path: gitops/apps
    directory: { recurse: true }
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated: { prune: true, selfHeal: true }
