# GENERATED by Terraform (terraform/gitops.tf).
# The NRG staging workloads, including whichever trap variants the overlay selects.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: nrg-workloads
  namespace: argocd
spec:
  project: default
  source:
    repoURL: ${repo_url}
    targetRevision: ${revision}
    path: manifests/overlays/staging
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    automated: { prune: true, selfHeal: true }
    syncOptions: [CreateNamespace=true, ServerSideApply=true]
  ignoreDifferences:
    # checkout-api's replica count belongs to its HPA, not Git (classic Argo + HPA fight otherwise).
    - group: apps
      kind: Deployment
      name: checkout-api
      jsonPointers: [/spec/replicas]
