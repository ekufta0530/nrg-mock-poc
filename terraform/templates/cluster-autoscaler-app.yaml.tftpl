# GENERATED by Terraform (terraform/gitops.tf). Left running on purpose: see the facilitator
# guide's "Cluster Autoscaler still running" extra. In GitOps the fix is a Git change
# (replicaCount: 0 below), not `kubectl scale`, which Argo's self-heal would revert.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cluster-autoscaler
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://kubernetes.github.io/autoscaler
    chart: cluster-autoscaler
    targetRevision: ${chart_version}
    helm:
      valuesObject:
        fullnameOverride: cluster-autoscaler
        cloudProvider: aws
        awsRegion: ${region}
        replicaCount: 1
        autoDiscovery:
          clusterName: ${cluster_name}
        rbac:
          serviceAccount:
            name: cluster-autoscaler
            annotations:
              eks.amazonaws.com/role-arn: ${irsa_role_arn}
        extraArgs:
          balance-similar-node-groups: true
          skip-nodes-with-system-pods: false
          expander: least-waste
          # Conservative scale-down keeps staging over-provisioned (the savings story).
          scale-down-utilization-threshold: "0.3"
          scale-down-unneeded-time: 30m
        resources:
          requests: { cpu: 100m, memory: 300Mi }
  destination:
    server: https://kubernetes.default.svc
    namespace: kube-system
  syncPolicy:
    automated: { prune: true, selfHeal: true }
