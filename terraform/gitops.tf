################################################################################
# Files derived from Terraform state that Argo CD needs in Git.
# Terraform writes them into this repo; commit + push them before bootstrapping Argo
# (scripts/bootstrap-gitops.sh checks). Set write_gitops_files = false to skip.
################################################################################

locals {
  gitops_root = "${path.module}/.."
}

resource "local_file" "root_app" {
  count    = var.write_gitops_files ? 1 : 0
  filename = "${local.gitops_root}/gitops/bootstrap/root-app.yaml"
  content = templatefile("${path.module}/templates/root-app.yaml.tftpl", {
    repo_url = var.gitops_repo_url
    revision = var.gitops_revision
  })
}

resource "local_file" "workloads_app" {
  count    = var.write_gitops_files ? 1 : 0
  filename = "${local.gitops_root}/gitops/apps/workloads.yaml"
  content = templatefile("${path.module}/templates/workloads-app.yaml.tftpl", {
    repo_url = var.gitops_repo_url
    revision = var.gitops_revision
  })
}

resource "local_file" "cluster_autoscaler_app" {
  count    = var.write_gitops_files ? 1 : 0
  filename = "${local.gitops_root}/gitops/apps/platform/cluster-autoscaler.yaml"
  content = templatefile("${path.module}/templates/cluster-autoscaler-app.yaml.tftpl", {
    cluster_name  = module.eks.cluster_name
    region        = var.region
    irsa_role_arn = module.cluster_autoscaler_irsa.iam_role_arn
    chart_version = var.cluster_autoscaler_chart_version
  })
}

# KMS ciphertext for notifications' init container (trap 2). Ciphertext of fake config: safe in Git.
resource "local_file" "notifications_config" {
  count    = var.write_gitops_files ? 1 : 0
  filename = "${local.gitops_root}/manifests/overlays/staging/generated/notifications-config.yaml"
  content  = <<-EOT
    # GENERATED by Terraform (terraform/gitops.tf). Do not edit.
    # config.enc is KMS ciphertext of fake config under alias/nrg-stag-app.
    apiVersion: v1
    kind: ConfigMap
    metadata:
      name: notifications-config
      namespace: notifications
    binaryData:
      config.enc: ${aws_kms_ciphertext.notifications_config.ciphertext_blob}
  EOT
}
